{
  "name": "spotflow-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @spotflow-games/server & npm run dev -w @spotflow-games/web & wait",
    "build": "npm run build -w @spotflow-games/shared && npm run build -w @spotflow-games/web && npm run build -w @spotflow-games/server",
    "start": "npm run start -w @spotflow-games/server",
    "db:generate": "npm run db:generate -w @spotflow-games/server",
    "db:migrate": "npm run db:migrate -w @spotflow-games/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "tokens": "node scripts/build-tokens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
