# Copy to .env for local development. Production values come from your secrets manager.
NODE_ENV=development
# Public URL people open. In dev, the Vite server proxies to the API.
APP_URL=http://localhost:5173
PORT=3001
DATABASE_URL=postgres://spotflow:spotflow@localhost:5432/spotflow_games

# At least 32 random characters, e.g. `openssl rand -base64 48`
COOKIE_SECRET=dev-only-cookie-secret-change-me-please-000

# Google Cloud console > APIs & Services > Credentials > OAuth client (Web application).
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=spotflow.one

# Comma-separated platform admins
ADMIN_EMAILS=korede@spotflow.one

# Lets you sign in as any @spotflow.one email without Google. Local only; refused in production.
DEV_LOGIN=true

LOBBY_EXPIRY_MINUTES=60

# Shared store for live sessions. Needed when more than one server instance runs (e.g. on Vercel).
# Leave empty locally to keep sessions in memory, or use the docker compose Redis: redis://localhost:6379
REDIS_URL=
